# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-cliente/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills (tooling, not app code)
.agents/

# Catálogo: fotos de producción y Excel de revisión (datos del negocio)
backups/catalogo/

# Respaldos locales (precios, costos, catálogos): nunca al repo
/backups/

# Datos del negocio y llaves: nunca al repo (además lo bloquea .githooks/pre-commit)
*.xlsx
*.xlsm
*.xls
*.csv
*.tsv
*.dump
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zip
*.bak
*.p12
*.pfx
*.key
*.p8
*.jks
*.keystore
*.ppk
*.ovpn
